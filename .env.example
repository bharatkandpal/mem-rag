# Copy to .env and fill in. Never commit .env. (TDD §3)
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
DATABASE_URL=postgresql://rag:rag@db:5432/rag

# Adapter selection + retrieval knobs (sane defaults)
EMBEDDING_PROVIDER=voyage
VOYAGE_MODEL=voyage-4-lite
RETRIEVAL_K=5
MIN_SCORE=0.2

# Chunking (tokens) — eval-tunable; defaults are the baseline (D9)
CHUNK_TOKENS=512
OVERLAP_TOKENS=64

# Generation adapter (D4 update) — provider-swappable, Claude is the default.
# GENERATION_PROVIDER=anthropic (default) | openai-compatible
GENERATION_PROVIDER=anthropic
GENERATION_MODEL=claude-opus-4-8

# Only used when GENERATION_PROVIDER=openai-compatible (OpenAI itself, or a
# self-hosted OpenAI-compatible server — Ollama, LM Studio, vLLM). No native
# citations on this surface — supportsCitations is false, citations always [].
# Example local setup: GENERATION_BASE_URL=http://localhost:11434/v1
#                       GENERATION_MODEL=llama3.2:1b  (leave GENERATION_API_KEY unset)
# GENERATION_BASE_URL=
# GENERATION_API_KEY=

# Eval quality gate — npm run eval exits 1 below this hit-rate floor (TDD §2.8)
EVAL_MIN_HIT_RATE=0.5
