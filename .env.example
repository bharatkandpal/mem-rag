# Copy to .env and fill in. Never commit .env. (TDD §3)
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
# Host-side tools (CLI, npm run eval) reach Postgres on localhost; inside
# docker compose the app gets its own DATABASE_URL (db:5432) from the compose file.
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag

# Adapter selection + retrieval knobs (sane defaults)
# EMBEDDING_PROVIDER=voyage (default, API, needs VOYAGE_API_KEY) | transformers
EMBEDDING_PROVIDER=voyage
VOYAGE_MODEL=voyage-4-lite
# Local, in-process embeddings (transformers.js) — no key, no network, self-hostable.
# Only used when EMBEDDING_PROVIDER=transformers. Default model is 1024-dim to match
# the VECTOR(1024) schema; a different-dim model needs a migration + full re-ingest.
# EMBEDDING_MODEL=Xenova/bge-large-en-v1.5
RETRIEVAL_K=5
# MIN_SCORE is embedding-model-specific (it's an absolute cosine floor, and every
# model has its own score scale). 0.3 is calibrated to Voyage (RAG-57); bge-large
# via EMBEDDING_PROVIDER=transformers needs ~0.59 (RAG-56f). Re-probe + re-run the
# eval whenever you swap embedding models — the floor does not transfer.
MIN_SCORE=0.3

# Chunking (tokens) — eval-tunable; defaults are the baseline (D9)
CHUNK_TOKENS=512
OVERLAP_TOKENS=64

# Generation adapter (D4 update) — provider-swappable, Claude is the default.
# GENERATION_PROVIDER=anthropic (default) | openai-compatible
GENERATION_PROVIDER=anthropic
GENERATION_MODEL=claude-opus-4-8

# Only used when GENERATION_PROVIDER=openai-compatible (OpenAI itself, or a
# self-hosted OpenAI-compatible server — Ollama, LM Studio, vLLM). No native
# citations on this surface — supportsCitations is false, citations always [].
# Example local setup: GENERATION_BASE_URL=http://localhost:11434/v1
#                       GENERATION_MODEL=llama3.2:1b  (leave GENERATION_API_KEY unset)
# GENERATION_BASE_URL=
# GENERATION_API_KEY=

# Eval quality gate — npm run eval exits 1 below this hit-rate floor (TDD §2.8)
EVAL_MIN_HIT_RATE=0.5
EVAL_MIN_ABSTAIN_RATE=0.5
