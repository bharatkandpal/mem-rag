# Copy to .env and fill in. Never commit .env. (TDD §3)
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
# Host-side tools (CLI, npm run eval) reach Postgres on localhost; inside
# docker compose the app gets its own DATABASE_URL (db:5432) from the compose file.
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag

# Adapter selection + retrieval knobs (sane defaults)
# EMBEDDING_PROVIDER — options: voyage | transformers
#   voyage       — default; hosted API, needs VOYAGE_API_KEY (set VOYAGE_MODEL)
#   transformers — local in-process transformers.js, no key/network (set EMBEDDING_MODEL)
EMBEDDING_PROVIDER=voyage
VOYAGE_MODEL=voyage-4-lite
# Local, in-process embeddings (transformers.js) — no key, no network, self-hostable.
# Only used when EMBEDDING_PROVIDER=transformers. Default model is 1024-dim to match
# the VECTOR(1024) schema; a different-dim model needs a migration + full re-ingest.
# EMBEDDING_MODEL=Xenova/bge-large-en-v1.5
# Where transformers.js caches downloaded weights. Its default is under node_modules,
# which is read-only for the nonroot user in the distroless container — the key-free
# run (docker-compose.local.yml) points this at a writable, persistent volume.
# TRANSFORMERS_CACHE=/hf-cache
RETRIEVAL_K=5
# MIN_SCORE is embedding-model-specific (it's an absolute cosine floor, and every
# model has its own score scale). 0.3 is calibrated to Voyage (RAG-57); bge-large
# via EMBEDDING_PROVIDER=transformers needs ~0.59 (RAG-56f). Re-probe + re-run the
# eval whenever you swap embedding models — the floor does not transfer.
MIN_SCORE=0.3

# Chunking (tokens) — eval-tunable; defaults are the baseline (D9)
CHUNK_TOKENS=512
OVERLAP_TOKENS=64

# Generation adapter (D4 update) — provider-swappable, Claude is the default.
# GENERATION_PROVIDER — options: anthropic | openai-compatible | citation-verifying
#   anthropic          — default; Claude via ANTHROPIC_API_KEY, native citations
#   openai-compatible  — OpenAI itself or a self-hosted OpenAI-compatible server
#                        (Ollama, LM Studio, vLLM); no citations. Needs
#                        GENERATION_BASE_URL (+ GENERATION_API_KEY if the server wants one)
#   citation-verifying — wraps another provider (CITATION_VERIFY_INNER_PROVIDER)
#                        and independently verifies which answer sentences are
#                        actually supported by the retrieved chunks (word-overlap
#                        against the real chunk text — never trusts the model's
#                        own claims). Reports supportsCitations=true honestly,
#                        since every citation is checked, not fabricated. See
#                        src/generation/citation-verifying-generation.provider.ts
GENERATION_PROVIDER=anthropic
GENERATION_MODEL=claude-opus-4-8

# Only used when GENERATION_PROVIDER=openai-compatible (OpenAI itself, or a
# self-hosted OpenAI-compatible server — Ollama, LM Studio, vLLM). No native
# citations on this surface — supportsCitations is false, citations always [].
# Example local setup: GENERATION_BASE_URL=http://localhost:11434/v1
#                       GENERATION_MODEL=llama3.2:1b  (leave GENERATION_API_KEY unset)
# GENERATION_BASE_URL=
# GENERATION_API_KEY=

# Only used when GENERATION_PROVIDER=citation-verifying — which provider it
# wraps (any name except citation-verifying itself). That inner provider's own
# env vars still apply (e.g. GENERATION_BASE_URL/GENERATION_MODEL for
# openai-compatible).
# CITATION_VERIFY_INNER_PROVIDER=openai-compatible

# Eval quality gate — npm run eval exits 1 below this hit-rate floor (TDD §2.8)
EVAL_MIN_HIT_RATE=0.5
EVAL_MIN_ABSTAIN_RATE=0.5

# Observability (RAG-63) — Prometheus metrics at GET /metrics + request
# correlation IDs. METRICS_ENABLED=false turns the /metrics route off and skips
# the process/GC/event-loop collectors (correlation IDs are always on).
METRICS_ENABLED=true

# MCP server (GO-21i / RAG-65) — `npm run mcp` serves the pipeline as MCP tools.
# rag_query is always on; MCP_ENABLE_INGEST=true additionally exposes the
# corpus-write rag_ingest tool (off by default — write access is a capability
# grant to any connected agent).
MCP_ENABLE_INGEST=false
# Transport (RAG-65e): stdio (default, local agents — no auth, parent-process
# trust) or http (Streamable HTTP for remote agents / the Anthropic API MCP
# connector). MCP_TRANSPORT=http REQUIRES MCP_AUTH_TOKEN — the server refuses to
# start HTTP without a bearer token (fail-closed). Never commit a real token.
MCP_TRANSPORT=stdio
MCP_HTTP_PORT=3001
# MCP_AUTH_TOKEN=
