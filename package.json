{
  "name": "rag-knowledge-store",
  "version": "0.1.0",
  "private": false,
  "description": "RAG knowledge-store chat with citation-grounded answers",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "rag": "dist/cli/main.js"
  },
  "scripts": {
    "build": "nest build",
    "migrate": "node dist/database/migrate.js",
    "mcp": "node dist/mcp/main.js",
    "prepack": "npm run build",
    "rag": "node dist/cli/main.js",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "typecheck": "tsc --noEmit",
    "eval": "ts-node --project tsconfig.eval.json eval/run-eval.ts",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.106.0",
    "@huggingface/transformers": "4.2.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@nestjs/common": "10.4.22",
    "@nestjs/config": "3.3.0",
    "@nestjs/core": "10.4.22",
    "@nestjs/platform-express": "10.4.22",
    "commander": "12.1.0",
    "gpt-tokenizer": "2.9.0",
    "pg": "8.22.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "10.4.9",
    "@nestjs/testing": "10.4.22",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.0",
    "@types/pg": "8.20.0",
    "@types/supertest": "7.2.0",
    "jest": "29.7.0",
    "supertest": "7.2.2",
    "ts-jest": "29.4.11",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  }
}
